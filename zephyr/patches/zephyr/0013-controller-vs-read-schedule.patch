+/* Read Schedule: the controller's running roles as its ticker has them (next event relative to
+ * the moment of the command, period and reserved slot), for host-side admission and diagnosis
+ */
+#define BT_HCI_OP_VS_READ_SCHEDULE              BT_OP(BT_OGF_VS, 0x0150)
+
+#define BT_HCI_VS_SCHED_ROLE_OTHER 0x00
+#define BT_HCI_VS_SCHED_ROLE_ADV   0x01
+#define BT_HCI_VS_SCHED_ROLE_AUX   0x02
+#define BT_HCI_VS_SCHED_ROLE_PA    0x03
+#define BT_HCI_VS_SCHED_ROLE_BIG   0x04
+#define BT_HCI_VS_SCHED_ROLE_SCAN  0x05
+#define BT_HCI_VS_SCHED_ROLE_ACL   0x06
+#define BT_HCI_VS_SCHED_ROLE_CIG   0x07
+
+struct bt_hci_vs_sched_entry {
+	uint8_t  ticker_id;
+	uint8_t  role;
+	uint32_t next_us;
+	uint32_t period_us;
+	uint32_t slot_us;
+} __packed;
+
+#define BT_HCI_VS_SCHED_ENTRIES_MAX 16
+
+struct bt_hci_rp_vs_read_schedule {
+	uint8_t status;
+	uint8_t count;
+	struct bt_hci_vs_sched_entry entry[];
+} __packed;
+
 #define BT_HCI_OP_VS_READ_USB_TRANSPORT_MODE    BT_OP(BT_OGF_VS, 0x0010)
 
