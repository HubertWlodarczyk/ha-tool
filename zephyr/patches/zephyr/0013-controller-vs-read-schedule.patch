+#include "ull_scan_types.h"
+#include "ull_iso_types.h"
+#include "ull_conn_types.h"
+#include "ull_conn_iso_types.h"
+
+#include "ull_internal.h"
+#include "ull_adv_internal.h"
+#include "ull_scan_internal.h"
+#include "ull_conn_internal.h"
+#include "ull_conn_iso_internal.h"
+
+#include "ll.h"
+
+#include "hal/debug.h"
+
+static void op_status_cb(uint32_t status, void *param)
+{
+	*((uint32_t volatile *)param) = status;
+}
+
+/* Role, period and reserved slot of a ticker; false for tickers that are no role (stop timers) */
+static bool role_of(uint8_t id, struct bt_hci_vs_sched_entry *e)
+{
+	const struct ull_hdr *hdr = NULL;
+
+	e->period_us = 0U;
+	if (false) {
+
+#if defined(CONFIG_BT_BROADCASTER)
+	} else if (IN_RANGE(id, TICKER_ID_ADV_BASE, TICKER_ID_ADV_LAST)) {
+		const struct ll_adv_set *adv = ull_adv_set_get(id - TICKER_ID_ADV_BASE);
+
+		e->role = BT_HCI_VS_SCHED_ROLE_ADV;
+		hdr = adv != NULL ? &adv->ull : NULL;
+#if defined(CONFIG_BT_CTLR_ADV_EXT) && (CONFIG_BT_CTLR_ADV_AUX_SET > 0)
+	} else if (IN_RANGE(id, TICKER_ID_ADV_AUX_BASE, TICKER_ID_ADV_AUX_LAST)) {
+		const struct ll_adv_aux_set *aux = ull_adv_aux_get(id - TICKER_ID_ADV_AUX_BASE);
+
+		e->role = BT_HCI_VS_SCHED_ROLE_AUX;
+		if (aux != NULL) {
+			hdr = &aux->ull;
+			e->period_us = aux->interval * PERIODIC_INT_UNIT_US;
+		}
+#if defined(CONFIG_BT_CTLR_ADV_PERIODIC)
+	} else if (IN_RANGE(id, TICKER_ID_ADV_SYNC_BASE, TICKER_ID_ADV_SYNC_LAST)) {
+		const struct ll_adv_sync_set *sync = ull_adv_sync_get(id - TICKER_ID_ADV_SYNC_BASE);
+
+		e->role = BT_HCI_VS_SCHED_ROLE_PA;
+		if (sync != NULL) {
+			hdr = &sync->ull;
+			e->period_us = sync->interval * PERIODIC_INT_UNIT_US;
+		}
+#if defined(CONFIG_BT_CTLR_ADV_ISO)
+	} else if (IN_RANGE(id, TICKER_ID_ADV_ISO_BASE, TICKER_ID_ADV_ISO_LAST)) {
+		const struct ll_adv_iso_set *big = ull_adv_iso_get(id - TICKER_ID_ADV_ISO_BASE);
+
+		e->role = BT_HCI_VS_SCHED_ROLE_BIG;
+		if (big != NULL) {
+			hdr = &big->ull;
+			e->period_us = big->lll.iso_interval * ISO_INT_UNIT_US;
+		}
+#endif /* CONFIG_BT_CTLR_ADV_ISO */
+#endif /* CONFIG_BT_CTLR_ADV_PERIODIC */
+#endif /* CONFIG_BT_CTLR_ADV_EXT && CONFIG_BT_CTLR_ADV_AUX_SET > 0 */
+#endif /* CONFIG_BT_BROADCASTER */
+
+#if defined(CONFIG_BT_OBSERVER)
+	} else if (IN_RANGE(id, TICKER_ID_SCAN_BASE, TICKER_ID_SCAN_LAST)) {
+		const struct ll_scan_set *scan = ull_scan_set_get(id - TICKER_ID_SCAN_BASE);
+
+		e->role = BT_HCI_VS_SCHED_ROLE_SCAN;
+		if (scan != NULL) {
+			hdr = &scan->ull;
+			e->period_us = scan->lll.interval * SCAN_INT_UNIT_US;
+		}
+#endif /* CONFIG_BT_OBSERVER */
+
+#if defined(CONFIG_BT_CONN)
+	} else if (IN_RANGE(id, TICKER_ID_CONN_BASE, TICKER_ID_CONN_LAST)) {
+		const struct ll_conn *conn = ll_conn_get(id - TICKER_ID_CONN_BASE);
+
+		e->role = BT_HCI_VS_SCHED_ROLE_ACL;
+		if (conn != NULL) {
+			hdr = &conn->ull;
+			e->period_us = conn->lll.interval * CONN_INT_UNIT_US;
+		}
+#endif /* CONFIG_BT_CONN */
+
+#if defined(CONFIG_BT_CTLR_CONN_ISO)
+	} else if (IN_RANGE(id, TICKER_ID_CONN_ISO_BASE, TICKER_ID_CONN_ISO_LAST)) {
+		const struct ll_conn_iso_group *cig =
+			ll_conn_iso_group_get_by_id(id - TICKER_ID_CONN_ISO_BASE);
+
+		e->role = BT_HCI_VS_SCHED_ROLE_CIG;
+		if (cig != NULL) {
+			hdr = &cig->ull;
+			e->period_us = cig->iso_interval * ISO_INT_UNIT_US;
+		}
+#endif /* CONFIG_BT_CTLR_CONN_ISO */
+
+	} else {
+		return false;
+	}
+
+	e->slot_us = hdr != NULL ? HAL_TICKER_TICKS_TO_US(hdr->ticks_slot) : 0U;
+
+	return true;
+}
+
+uint8_t ll_sched_read(struct bt_hci_vs_sched_entry *entry, uint8_t max)
+{
+	uint32_t ticks_ref = 0U;
+	uint32_t ticks_ref_prev = 0U;
+	uint8_t retry = UINT8_MAX;
+	uint8_t ticker_id = TICKER_NULL;
+	uint8_t count = 0U;
+
+	while (count < max) {
+		uint32_t volatile ret_cb = TICKER_STATUS_BUSY;
+		uint32_t ticks_to_expire;
+		uint32_t remainder;
+		uint32_t ret;
+
+		ret = ticker_next_slot_get_ext(TICKER_INSTANCE_ID_CTLR, TICKER_USER_ID_THREAD,
+					       &ticker_id, &ticks_ref, &ticks_to_expire,
+					       &remainder, NULL, NULL, NULL, op_status_cb,
+					       (void *)&ret_cb);
+		if (ret == TICKER_STATUS_BUSY) {
+			while (ret_cb == TICKER_STATUS_BUSY) {
+				ticker_job_sched(TICKER_INSTANCE_ID_CTLR, TICKER_USER_ID_THREAD);
+			}
+		}
+
+		if (ret_cb != TICKER_STATUS_SUCCESS || ticker_id == TICKER_NULL) {
+			break;
+		}
+
+		/* Tickers expired while iterating: start over from the new reference */
+		if (count > 0U && ticks_ref != ticks_ref_prev) {
+			if (--retry == 0U) {
+				break;
+			}
+
+			ticker_id = TICKER_NULL;
+			count = 0U;
+			continue;
+		}
+
+		ticks_ref_prev = ticks_ref;
+		entry[count].ticker_id = ticker_id;
+		if (!role_of(ticker_id, &entry[count])) {
+			continue;
+		}
+
+		entry[count].next_us = HAL_TICKER_TICKS_TO_US(ticks_to_expire);
+		count++;
+	}
+
+	return count;
+}
