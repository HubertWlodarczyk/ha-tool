+#if defined(CONFIG_BT_TICKER_NEXT_SLOT_GET_MATCH)
+static void vs_read_schedule(struct net_buf *buf, struct net_buf **evt)
+{
+	struct bt_hci_vs_sched_entry entry[BT_HCI_VS_SCHED_ENTRIES_MAX];
+	struct bt_hci_rp_vs_read_schedule *rp;
+	uint8_t count;
+
+	ARG_UNUSED(buf);
+
+	count = ll_sched_read(entry, ARRAY_SIZE(entry));
+	rp = hci_cmd_complete(evt, sizeof(*rp) + count * sizeof(entry[0]));
+	rp->status = 0x00;
+	rp->count = count;
+	for (uint8_t i = 0U; i < count; i++) {
+		rp->entry[i].ticker_id = entry[i].ticker_id;
+		rp->entry[i].role = entry[i].role;
+		rp->entry[i].next_us = sys_cpu_to_le32(entry[i].next_us);
+		rp->entry[i].period_us = sys_cpu_to_le32(entry[i].period_us);
+		rp->entry[i].slot_us = sys_cpu_to_le32(entry[i].slot_us);
+	}
+}
+#endif /* CONFIG_BT_TICKER_NEXT_SLOT_GET_MATCH */
