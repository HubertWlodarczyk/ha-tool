diff --git a/subsys/bluetooth/controller/ll_sw/ull_adv_iso.c b/subsys/bluetooth/controller/ll_sw/ull_adv_iso.c
--- a/subsys/bluetooth/controller/ll_sw/ull_adv_iso.c
+++ b/subsys/bluetooth/controller/ll_sw/ull_adv_iso.c
@@ -95,6 +95,25 @@
 			stream_pool[CONFIG_BT_CTLR_ADV_ISO_STREAM_COUNT];
 static void *stream_free;
 
+
+/* Streams acquired by a BIG create that fails afterwards: return them to the pool (each failure
+ * used to keep its BISes, and after a few refused creates every new BIG failed with Memory
+ * Capacity Exceeded until reset)
+ */
+static void big_create_streams_release(struct lll_adv_iso *lll_adv_iso)
+{
+	for (uint8_t i = 0U; i < lll_adv_iso->num_bis; i++) {
+		struct lll_adv_iso_stream *stream;
+
+		stream = ull_adv_iso_stream_get(lll_adv_iso->stream_handle[i]);
+		stream->link_tx_free = memq_deinit(&stream->memq_tx.head,
+						   &stream->memq_tx.tail);
+		mem_release(stream, &stream_free);
+	}
+
+	lll_adv_iso->num_bis = 0U;
+}
+
 static uint8_t big_create(uint8_t big_handle, uint8_t adv_handle, uint8_t num_bis,
 			  uint32_t sdu_interval, uint16_t max_sdu,
 			  uint16_t max_latency, uint8_t rtn, uint8_t phy,
@@ -448,6 +467,7 @@
 		/* Release allocated link buffers */
 		ll_rx_link_release(link_cmplt);
 		ll_rx_link_release(link_term);
+		big_create_streams_release(lll_adv_iso);
 
 		return BT_HCI_ERR_INVALID_PARAM;
 	}
@@ -461,6 +481,10 @@
 		lll_adv_iso->pto = pto;
 
 		if (pto && !lll_adv_iso->ptc) {
+			ll_rx_link_release(link_cmplt);
+			ll_rx_link_release(link_term);
+			big_create_streams_release(lll_adv_iso);
+
 			return BT_HCI_ERR_INVALID_PARAM;
 		}
