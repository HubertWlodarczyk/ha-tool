+/** @brief Select the local identity used when initiating LE connections.
+ *
+ *  Subsequent calls to bt_conn_le_create() initiate the connection from the
+ *  identity address of @p id, and the resulting connection (and any bond
+ *  created on it) belongs to that identity.
+ *
+ *  @param id Local identity, as returned by bt_id_create(). BT_ID_DEFAULT
+ *            restores the default behavior.
+ *
+ *  @return Zero on success, -EINVAL for an unknown identity or -EBUSY while
+ *          a connection is being initiated.
+ */
+int bt_conn_le_create_set_id(uint8_t id);
