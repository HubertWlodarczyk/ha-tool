+static uint8_t le_create_id = BT_ID_DEFAULT;
+
+int bt_conn_le_create_set_id(uint8_t id)
+{
+	if (id >= bt_dev.id_count) {
+		return -EINVAL;
+	}
+
+	if (atomic_test_bit(bt_dev.flags, BT_DEV_INITIATING)) {
+		return -EBUSY;
+	}
+
+	le_create_id = id;
+
+	return 0;
+}
+
+uint8_t bt_conn_le_create_id_get(void)
+{
+	return le_create_id;
+}
