diff --git a/subsys/bluetooth/controller/Kconfig b/subsys/bluetooth/controller/Kconfig
index b8c425d6fe3..c83e3284312 100644
--- a/subsys/bluetooth/controller/Kconfig
+++ b/subsys/bluetooth/controller/Kconfig
@@ -978,6 +978,17 @@ config BT_CTLR_ADV_ISO_STREAM_COUNT
 	  Maximum Broadcast ISO Streams supported in the Controller across
 	  all Broadcast ISO groups.
 
+config BT_CTLR_ADV_ISO_PTO_GROUP_COUNT
+	int "Pre-Transmission groups added to BIG events with free time"
+	depends on BT_CTLR_ADV_ISO
+	range 0 1
+	default 1
+	help
+	  When a BIG event has time left in its ISO interval, the controller adds
+	  pre-transmission subevents (future SDUs sent in advance) for time
+	  diversity. They lengthen every BIG event, so fewer BIGs fit next to each
+	  other. 0 disables it: BIG events only hold BN x IRC subevents per BIS.
+
 config BT_CTLR_ADV_ISO_PDU_LEN_MAX
 	int "Maximum Broadcast Isochronous Channel PDU Length"
 	depends on BT_CTLR_ADV_ISO
diff --git a/subsys/bluetooth/controller/ll_sw/ull_adv_iso.c b/subsys/bluetooth/controller/ll_sw/ull_adv_iso.c
index 910b60999f3..fae4bc13407 100644
--- a/subsys/bluetooth/controller/ll_sw/ull_adv_iso.c
+++ b/subsys/bluetooth/controller/ll_sw/ull_adv_iso.c
@@ -56,11 +56,9 @@
  * BIG events.
  * The number of Pre-Transmission Group Count configure how many future ISO SDUs
  * from the Offset will be Pre-Transmitted in advance in the current BIG event.
- *
- * TODO: These could be a Kconfig option.
  */
 #define BT_CTLR_ADV_ISO_PTO_MIN         1U
-#define BT_CTLR_ADV_ISO_PTO_GROUP_COUNT 1U
+#define BT_CTLR_ADV_ISO_PTO_GROUP_COUNT CONFIG_BT_CTLR_ADV_ISO_PTO_GROUP_COUNT
 
 static int init_reset(void);
 static struct ll_adv_iso_set *adv_iso_get(uint8_t handle);
