root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,ld}]
indent_style = tab
tab_width = 8
max_line_length = 100

[{CMakeLists.txt,*.cmake,*.conf,*.overlay}]
indent_style = space
indent_size = 2

[*.{py,java,yaml,toml,md}]
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
