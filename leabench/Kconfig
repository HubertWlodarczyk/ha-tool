mainmenu "LEA Bench"

menu "LEA Bench limits"

config LEA_BCAST_MAX_BIGS
	int "Broadcast sources (BIGs) that can exist at the same time"
	range 1 3
	default 3
	help
	  Separate BIGs are needed for streams that differ in BIG-level parameters
	  (encryption, PHY, frame duration / ISO interval, RTN). Must not exceed
	  BT_CTLR_ADV_ISO_SET of the controller image (leabench/netcore.conf).
	  The air time budget allows at most 3 BIGs (each costs ~2.4 ms of every
	  10 ms besides its BISes).

config LEA_BCAST_MAX_SUBGROUPS
	int "Subgroups per broadcast source"
	range 1 8
	default 4

config LEA_BCAST_MAX_BIS
	int "BISes per broadcast source"
	range 1 8
	default 8
	help
	  Must not exceed BT_CTLR_ADV_ISO_STREAM_MAX of the controller image
	  (leabench/netcore.conf). Air time is the practical limit: see 'bcast show'.

config LEA_BCAST_MAX_BIS_TOTAL
	int "BISes of all broadcasts together"
	range 1 16
	default 16
	help
	  Must match BT_CTLR_ADV_ISO_STREAM_COUNT of the controller image
	  (leabench/netcore.conf); 16 is what the 64 KB RAM of the nRF5340 network
	  core allows with the trimmed controller.

endmenu

configdefault BT_ISO_MAX_BIG
	default LEA_BCAST_MAX_BIGS

configdefault BT_BAP_BROADCAST_SRC_COUNT
	default LEA_BCAST_MAX_BIGS

configdefault BT_BAP_BROADCAST_SRC_SUBGROUP_COUNT
	default LEA_BCAST_MAX_SUBGROUPS

configdefault BT_BAP_BROADCAST_SRC_STREAM_COUNT
	default LEA_BCAST_MAX_BIS

source "Kconfig.zephyr"
